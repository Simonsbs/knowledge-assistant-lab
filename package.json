{
  "name": "knowledge-assistant-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An independent knowledge assistant and retrieval evaluation lab with optional local Ollama inference.",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:local": "node scripts/dev-local.mjs",
    "serve": "node scripts/python.mjs server/server.py",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit && node --experimental-strip-types scripts/ingest.mjs --check && npm test",
    "test": "node --experimental-strip-types --test tests/engine.test.mjs",
    "test:server": "node scripts/python.mjs -m unittest discover -s tests -p test_*.py -v",
    "ingest": "node --experimental-strip-types scripts/ingest.mjs",
    "evaluate": "node --experimental-strip-types scripts/evaluate.mjs",
    "evaluate:live": "node scripts/python.mjs server/evaluate_live.py",
    "build": "npm run check && vite build"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
